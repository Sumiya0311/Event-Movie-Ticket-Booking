# MySQL Database
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/event_movie_booking

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP Email Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=YOUR_MAILTRAP_USERNAME
SMTP_PASSWORD=YOUR_MAILTRAP_PASSWORD
SMTP_FROM_EMAIL=tickets@example.com

# Ticket QR Code
TICKET_HMAC_SECRET=replace_with_another_long_random_secret